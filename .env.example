# Amarante — desenvolvimento local (copiar para `.env` e `backend/.env`)
# Nunca versionar `.env` real com secrets de produção.
# Na VPS: use o MESMO DATABASE_URL nos dois arquivos (raiz e backend/).

# PostgreSQL (scripts setup/migrate/check leem esta URL — não há usuário hardcoded)
DATABASE_URL=postgresql://postgree:postgree@127.0.0.1:5432/amarante?schema=public

# Opcional — só se o setup precisar criar role/DB como superuser (VPS)
# POSTGRES_ADMIN_URL=postgresql://postgres:SENHA_ADMIN@127.0.0.1:5432/postgres
# POSTGRES_ADMIN_USER=postgres
# POSTGRES_ADMIN_PASS=SENHA_ADMIN

# API
PORT=3000
CORS_ORIGIN=http://localhost:5180,http://127.0.0.1:5180
NODE_ENV=development

# JWT (access + refresh) — cookies httpOnly
# Em produção: secrets longos e aleatórios (sem "change-in-prod")
JWT_ACCESS_SECRET=amarante-dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=amarante-dev-refresh-secret-change-in-prod
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Só local: true cria admin@amarante.local no boot. Produção: deixe false.
SEED_DEMO_USER_ON_BOOT=false

# --- Frontend (opcional; copiar para frontend/.env se precisar sobrescrever) ---
# VITE_API_URL=http://localhost:3000/api
