# Amarante — copiar para `.env` e deixar os scripts espelharem em `backend/.env`
# Nunca versionar `.env` real com secrets.
#
# VPS: edite SÓ a raiz `.env`, depois: cp .env backend/.env
#      ou rode verify-env / setup / migrate (sincronizam automaticamente).
# Guia: docs/projeto/deploy-vps.md

# PostgreSQL da APLICAÇÃO (não use o superuser postgres aqui)
# Local default:
DATABASE_URL=postgresql://postgree:postgree@127.0.0.1:5432/amarante?schema=public
# VPS exemplo:
# DATABASE_URL=postgresql://amarante_app:SENHA_FORTE@127.0.0.1:5432/amarante?schema=public

# Opcional — só se setup.sh precisar CRIAR role/DB como superuser
# POSTGRES_ADMIN_URL=postgresql://postgres:SENHA_ADMIN@127.0.0.1:5432/postgres
# POSTGRES_ADMIN_USER=postgres
# POSTGRES_ADMIN_PASS=SENHA_ADMIN

# API
PORT=3000
# Domínio público da UI (vírgula se vários). Em VPS use https://seu-dominio
CORS_ORIGIN=http://localhost:5180,http://127.0.0.1:5180
# development | production | test
NODE_ENV=development

# JWT — em produção: strings longas aleatórias (sem "change-in-prod")
JWT_ACCESS_SECRET=amarante-dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=amarante-dev-refresh-secret-change-in-prod
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# true só em lab local. Produção/VPS de teste estável: false
SEED_DEMO_USER_ON_BOOT=false

# --- Frontend (build) ---
# Default da SPA é /api (nginx faz proxy). Só sobrescreva se a API for outro host:
# VITE_API_URL=/api
